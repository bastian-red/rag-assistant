{
  "name": "@rag/evals",
  "version": "0.1.0",
  "private": true,
  "description": "The periodic eval lane: a pinned corpus with gold spans, the real models, the code the API runs (ingest pipeline, retrieval, @rag/answer), deterministic scores and a validated open-model judge, thresholds that fail the run.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "eval": "node dist/main.js"
  },
  "dependencies": {
    "@rag/answer": "workspace:*",
    "@rag/chunker": "workspace:*",
    "@rag/citations": "workspace:*",
    "@rag/db": "workspace:*",
    "@rag/ingest": "workspace:*",
    "@rag/llm": "workspace:*",
    "@rag/retrieval": "workspace:*",
    "@rag/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rag/config": "workspace:*",
    "@types/node": "^24.19.2",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
