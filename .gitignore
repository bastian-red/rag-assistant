# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# test / coverage
coverage/
playwright-report/
test-results/
.turbo/

# local-only (never published)
docs/

# logs
*.log
npm-debug.log*

# os
.DS_Store

# Prisma client is generated into the package (see schema.prisma) and rebuilt
# by `pnpm db:generate`; it is a build output, not source.
packages/db/generated/

# Next 16 rewrites this on every run, differently for `next dev` (.next/dev/types)
# and `next build` (.next/types), so tracking it leaves the tree dirty after any
# `pnpm dev`. Next's own templates ignore it; typecheck passes without it.
apps/web/next-env.d.ts

# A red-proofs.mjs backup, present only while a proof runs (or after a killed run).
*.red-proof-orig

# Local data: uploaded files under pnpm dev.
.data/
