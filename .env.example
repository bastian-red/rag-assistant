# rag-assistant environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json, and `node scripts/env-contract.mjs`
# fails the commit if this file, the source and turbo.json disagree. Turborepo 2
# runs in strict environment mode, so a name turbo.json forgets is stripped from
# the child process silently. Nothing loads this file on its own: `pnpm dev`
# runs scripts/dev.sh, which sources it.

# --- Core ---

# Leave unset for development: `next build` must not see "development".
NODE_ENV=

APP_VERSION=0.1.0

# --- Database (Postgres with pgvector) ---

# Compose publishes Postgres on 5445: 5432 is the host's own server and
# 5433-5444 belong to sibling stacks.
DATABASE_URL=postgresql://rag:rag@localhost:5445/rag?schema=public

# --- Redis ---

# The throttler's counters, the ingest queue (BullMQ) and the ingest events
# (pub/sub) the library page follows.
REDIS_URL=redis://localhost:6391

# --- Model server (Ollama, open-weight models only) ---

# A local Ollama. `./scripts/ollama-setup.sh` installs it user-locally (no
# sudo) and pulls both models below. Inside compose's `ollama` profile it is
# http://ollama:11434.
OLLAMA_URL=http://localhost:11434

# The chat model. qwen3:4b-instruct (2507, ~2.5 GB) is the strongest that
# answers at a usable speed on a CPU-only laptop beside the rest of the stack.
# It must be an instruct build: a thinking-only build (plain `qwen3:4b` is one)
# writes its reasoning into the answer, and /health refuses it by name.
CHAT_MODEL=qwen3:4b-instruct

# The embedding model (1024 dimensions). Changing it means re-embedding every
# document, because vectors from two models are not comparable.
EMBED_MODEL=qwen3-embedding:0.6b

# --- API service ---

API_PORT=4600

# PORT wins over API_PORT, matching what every container runtime injects. Empty
# locally: the web app reads PORT too.
PORT=

# Where the web app's server code reaches the API. The browser never calls it.
API_BASE_URL=http://localhost:4600

# Requests per minute. Signed-in calls are counted per user, anonymous ones per
# address. The auth budget must stay below the global one or the API refuses
# to start.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
# Uploads per minute per person. Below the global budget or the API refuses
# to start: an upload is the most expensive call there is.
RATE_LIMIT_UPLOAD=10

# --- Uploads (shared by the API and the ingest worker) ---

# Where uploaded files are stored, by owner and content hash. Relative values
# are resolved against the repo root by scripts/load-env.sh, because the API
# and the worker run from different directories. In compose it is a volume
# both containers mount.
UPLOAD_DIR=.data/uploads

# --- Ingest worker ---

# Its /health port, and where the API's /status asks it.
INGEST_PORT=4500
INGEST_URL=http://localhost:4500

# Documents ingested at once. One is right for a CPU-only laptop: the
# embedding model is the bottleneck, and two at once only interleave.
INGEST_CONCURRENCY=1

# How long a job's lock lives (ms). A killed worker's document is picked up
# by another after about twice this.
INGEST_LOCK_MS=30000

# How often the worker looks for documents that need a job (ms): unfinished
# ones with none, and ready ones embedded by another model than the one the
# model server runs now, which it embeds again.
INGEST_SWEEP_MS=60000

# --- Web app ---

WEB_PORT=3600

# The site's own origin, for absolute URLs in page metadata.
APP_BASE_URL=http://localhost:3600

# --- Auth ---

# One value, two processes: the web app mints a short-lived HS256 service token
# and the API verifies it. At least 16 characters.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3600
