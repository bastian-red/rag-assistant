{
  "name": "@rag/chunker",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, structure-aware chunking: normalisation, sentence-safe packing, code-point spans and page ranges, and a token estimate calibrated against the embedding model.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "calibrate": "node scripts/calibrate-tokens.mjs"
  },
  "devDependencies": {
    "@rag/config": "workspace:*",
    "@types/node": "^20.17.6",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
