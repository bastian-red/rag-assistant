# syntax=docker/dockerfile:1.7
#
# @rag/web (Next.js 16, output: 'standalone'). Build from the REPO ROOT:
#   docker build -f infra/Dockerfile.web -t rag-web .

# base, fetch and the install below are the same instructions, in the same
# order, as Dockerfile.api, openssl included although Next never needs it.
# BuildKit keys its cache on the instructions, so the images share one fetched store and one installed node_modules (about
# 1 GB) instead of building two of them: a 12 GB Docker disk ran out on the
# second copy. The runtime stage below starts from a clean image either way.
FROM node:20-bookworm-slim AS base
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS fetch
# package.json for its pnpm.supportedArchitectures: glibc binaries only. Without
# it the store also carries the musl builds of next's compiler and sharp
# (about 300 MB) that a bookworm image never loads.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# --ignore-scripts: simple-git-hooks' postinstall walks up for a package.json this
# stage has deliberately not copied, and crashes the fetch.
RUN pnpm fetch --ignore-scripts

FROM fetch AS build
COPY . .
RUN pnpm install --frozen-lockfile --offline --ignore-scripts

# AUTH_SECRET is needed at build time only because auth.ts is evaluated while Next
# enumerates routes. This placeholder is allowlisted in .gitleaks.toml and is never
# the runtime secret, which comes from the environment the container runs with.
ENV NODE_ENV=production
ENV AUTH_SECRET=build-time-placeholder-secret-32chars
RUN pnpm exec turbo run build --filter=@rag/web...
RUN mkdir -p apps/web/public

# Standalone output reproduces the monorepo-relative path (outputFileTracingRoot
# is the repo root), so server.js lands under apps/web/. Asserted, so a wrong
# assumption is a build failure with a listing rather than an image without it.
RUN test -f apps/web/.next/standalone/apps/web/server.js || \
  (echo "build: expected apps/web/.next/standalone/apps/web/server.js. Found:" >&2 \
   && find apps/web/.next/standalone -maxdepth 3 >&2 && exit 1)

FROM node:20-bookworm-slim AS runtime
RUN groupadd --gid 1001 app \
  && useradd --uid 1001 --gid app --shell /usr/sbin/nologin --no-create-home app
WORKDIR /app
# Static assets and public/ are excluded from Next's trace by design and copied
# in beside server.js.
COPY --from=build --chown=app:app /repo/apps/web/.next/standalone ./
COPY --from=build --chown=app:app /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=app:app /repo/apps/web/public ./apps/web/public
USER app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 3600
# /sign-in rather than /status: the status page probes the other services, so a
# check pointed at it would mark this container unhealthy for somebody else's
# outage.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3600)+'/sign-in',(r)=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
