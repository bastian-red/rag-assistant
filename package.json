{
  "name": "rag-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "./scripts/dev.sh",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "./scripts/integration.sh",
    "test:e2e": "./scripts/e2e.sh",
    "evals": "./scripts/evals.sh",
    "db:generate": "pnpm --filter @rag/db generate",
    "db:migrate": "./scripts/with-env.sh pnpm --filter @rag/db migrate:dev",
    "db:deploy": "./scripts/with-env.sh turbo run migrate:deploy --filter=@rag/db",
    "db:seed": "./scripts/with-env.sh turbo run seed --filter=@rag/db",
    "db:drift": "./scripts/db-drift.sh",
    "db:seed-check": "./scripts/seed-check.sh",
    "env:contract": "node scripts/env-contract.mjs",
    "env:contract:self-test": "node scripts/env-contract.mjs --self-test",
    "scan:invisible": "node scripts/invisible-chars.mjs",
    "scan:invisible:self-test": "node scripts/invisible-chars.mjs --self-test",
    "scan:self-import": "node scripts/self-import.mjs",
    "scan:self-import:self-test": "node scripts/self-import.mjs --self-test",
    "scan:node-pin": "node scripts/node-pin.mjs",
    "scan:node-pin:self-test": "node scripts/node-pin.mjs --self-test",
    "scan:secrets": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "prepare": "node scripts/install-hooks.mjs",
    "ollama:setup": "./scripts/ollama-setup.sh",
    "ollama:fake": "turbo run build --filter=@rag/llm --output-logs=errors-only && node services/llm/dist/fake/main.js",
    "llm:contract:real": "./scripts/llm-contract-real.sh"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec node scripts/pre-commit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0 <3",
      "body-parser": "^1.20.9",
      "qs": "^6.16.0"
    },
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current"
      ],
      "libc": [
        "glibc"
      ]
    }
  }
}
